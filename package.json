{
  "name": "cyberpunk-ui",
  "version": "0.1.0",
  "description": "A cyberpunk-themed React UI component library",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --open",
    "build": "vite build && tsc --declaration --emitDeclarationOnly --outDir dist",
    "build:lib": "vite build --config vite.config.lib.ts",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,less,json}\"",
    "preview": "vite preview",
    "site:dev": "vite --config site/vite.config.ts --open",
    "site:build": "vite build --config site/vite.config.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "less": "^4.2.0",
    "prettier": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vite-plugin-dts": "^3.7.0"
  },
  "keywords": [
    "cyberpunk",
    "react",
    "ui",
    "component-library",
    "typescript"
  ],
  "license": "MIT"
}
